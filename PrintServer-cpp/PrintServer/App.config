<?xml version="1.0" encoding="utf-8"?>
<!--
  配置样例（1.4.2 起不再由构建脚本复制到输出目录）：

  程序首次运行时会按内置模板自动生成 PrintServer.exe.config，
  之后所有修改都写在该文件中。本文件仅作为可读的配置项说明，
  修改它不会影响已部署的程序。

  端口记忆规则：
    Printer<n>_Name/Port/Enabled 是一组"稳定槽位"，n 只增不减。
    取消勾选只把 Enabled 置 false，保留 Name/Port；
    重新勾选时沿用原槽位与原端口，不会因为勾选顺序变化而重排。
-->
<configuration>
  <appSettings>
    <!-- 打印机数量：0 表示兼容旧单打印机模式（PrinterName/Port） -->
    <add key="PrinterCount" value="0"/>
    <add key="PrinterName" value=""/>
    <add key="Port" value="9100"/>
    <!-- 控制 API 端口（客户端发现与驱动下载） -->
    <add key="ApiPort" value="9180"/>
    <!-- IPP 免驱打印（RFC 8010/8011，标准端口 631） -->
    <add key="IppEnabled" value="true"/>
    <add key="IppPort" value="631"/>
    <add key="IppMdnsEnabled" value="true"/>
    <add key="IppPdfRendering" value="true"/>
    <add key="IppRenderDpi" value="300"/>
    <add key="IppMaxDocumentMB" value="64"/>
    <add key="IppDuplex" value="false"/>
    <add key="IppColor" value="false"/>
    <!-- 公共配置 -->
    <add key="AutoStart" value="false"/>
    <add key="LogRetentionDays" value="15"/>
    <add key="ReceiveTimeout" value="30"/>
  </appSettings>
</configuration>
