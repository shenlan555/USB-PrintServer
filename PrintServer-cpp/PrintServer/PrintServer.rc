//
// Dialog
//

// 对应 C# PrintServerForm：Size 560x670，FormBorderStyle.FixedSingle（细边框、
// 只带最小化框）。注意 MFC 还会给对话框加 WS_EX_DLGMODALFRAME（经典粗模态边框），
// 该样式在 OnInitDialog 中移除，否则客户区是 544x631 而非 WinForms 的 554x641
IDD_MAIN_DIALOG DIALOGEX 0, 0, 375, 348
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "PrintServer v1.4.2"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

// 对应 C# LicenseForm：Size 560x510，Sizable + 最小/最大同值（实际固定尺寸）
IDD_LICENSE_DIALOG DIALOGEX 0, 0, 375, 265
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "PrintServer 授权激活"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
END

